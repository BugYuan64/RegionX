    <!-- 模型名 → 品牌 -->
    <DataTemplate x:Key="BrandIconTemplate">
        <Viewbox Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0">
            <Path Data="{Binding Converter={StaticResource BrandIcon}}"
                  Stroke="{DynamicResource TextSecondaryBrush}"
                  StrokeThickness="0"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Fill="{DynamicResource TextSecondaryBrush}" />
        </Viewbox>
    </DataTemplate>

    <!-- 深色主题下品牌图标用浅色，白底主题下用深色：颜色跟随 TextSecondaryBrush 令牌 -->
    <Style x:Key="BrandIconStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

</ResourceDictionary>


