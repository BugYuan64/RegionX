<Window x:Class="ScreenAssistant.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RegionX 识别框"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Width="570" Height="300">

    <!--
        框内区域完全不绘制任何内容（alpha = 0），
        分层窗口按像素判定命中，这部分点击会穿透到下面的桌面。
        只有边框描边、四条边的拖动热区和四个角的缩放手柄接收鼠标。
    -->
    <Grid x:Name="RootGrid" Background="{x:Null}">
        <!--
            拖动热区：整条边框（10px）都可拖动移动。
            注意 Z 序 —— 四角缩放手柄必须声明在边之后（更靠上层），
            否则边会把角完全盖住，导致拖角缩放触发不了。
            四边在角两侧各留出 14px，把角落让给缩放手柄。
        -->
        <Border x:Name="Frame"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2"
                Background="{x:Null}"
                Cursor="SizeAll"
                MouseLeftButtonDown="Frame_MouseLeftButtonDown" />

        <Border x:Name="HandleN" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Margin="14,0" Background="{DynamicResource HitTestBrush}" Cursor="SizeAll"
                MouseLeftButtonDown="Frame_MouseLeftButtonDown" />
        <Border x:Name="HandleS" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                Margin="14,0" Background="{DynamicResource HitTestBrush}" Cursor="SizeAll"
                MouseLeftButtonDown="Frame_MouseLeftButtonDown" />
        <Border x:Name="HandleW" Width="10" VerticalAlignment="Stretch" HorizontalAlignment="Left"
                Margin="0,14" Background="{DynamicResource HitTestBrush}" Cursor="SizeAll"
                MouseLeftButtonDown="Frame_MouseLeftButtonDown" />
        <Border x:Name="HandleE" Width="10" VerticalAlignment="Stretch" HorizontalAlignment="Right"
                Margin="0,14" Background="{DynamicResource HitTestBrush}" Cursor="SizeAll"
                MouseLeftButtonDown="Frame_MouseLeftButtonDown" />

        <!--
            四角缩放手柄：24px 命中区（视觉 12px 居中），放在最上层，
            保证角上的点击一定走「缩放」而不是「移动」。
        -->
        <Border x:Name="HandleNW" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" Cursor="SizeNWSE" Tag="NW"
                MouseLeftButtonDown="Handle_MouseLeftButtonDown">
            <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="3"
                    Background="{DynamicResource HandleFillBrush}" />
        </Border>
        <Border x:Name="HandleNE" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" Cursor="SizeNESW" Tag="NE"
                MouseLeftButtonDown="Handle_MouseLeftButtonDown">
            <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="3"
                    Background="{DynamicResource HandleFillBrush}" />
        </Border>
        <Border x:Name="HandleSW" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="SizeNESW" Tag="SW"
                MouseLeftButtonDown="Handle_MouseLeftButtonDown">
            <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="3"
                    Background="{DynamicResource HandleFillBrush}" />
        </Border>
        <Border x:Name="HandleSE" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="SizeNWSE" Tag="SE"
                MouseLeftButtonDown="Handle_MouseLeftButtonDown">
            <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="3"
                    Background="{DynamicResource HandleFillBrush}" />
        </Border>

        <!-- 左上角尺寸标签（UI 方案：识别框 570 × 200），只在操作时出现 -->
        <Border x:Name="SizeLabel" VerticalAlignment="Top" HorizontalAlignment="Left"
                Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="10,3"
                Margin="0,-30,0,0" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="SizeLabelText" Text="识别框 570 × 300"
                       Foreground="{DynamicResource OnAccentBrush}"
                       FontSize="12" FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" />
        </Border>
    </Grid>
</Window>
