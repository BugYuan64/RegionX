<Window x:Class="ScreenAssistant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScreenAssistant.App.ViewModels"
        xmlns:c="clr-namespace:ScreenAssistant.App.Controls"
        xmlns:views="clr-namespace:ScreenAssistant.App.Views"
        Title="RegionX"
        Width="1200" Height="760"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 会话头：整行可点，内容两端对齐 -->
        <Style x:Key="SessionHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="20,16" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 会话里的一条任务 -->
        <DataTemplate x:Key="TaskRowTemplate" DataType="{x:Type vm:TaskItemViewModel}">
            <Button x:Name="Row" Background="Transparent" Padding="20,14" Cursor="Hand"
                    HorizontalContentAlignment="Stretch" BorderThickness="0"
                    AutomationProperties.Name="{Binding Title}"
                    Click="TaskRow_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                            Background="{DynamicResource SurfaceHoverBrush}" VerticalAlignment="Top">
                        <c:Icon Data="{Binding Kind, Converter={StaticResource KindToIcon}}"
                                Size="18" Foreground="{DynamicResource AccentBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <!-- 与任务队列一致：AI 回复第一行 -->
                        <TextBlock Text="{Binding ResultLine}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Ellipse Style="{StaticResource StatusDot}"
                                     Fill="{Binding Status, Converter={StaticResource StateToBrush}}" />
                            <TextBlock Text="{Binding Status, Converter={StaticResource StateToText}}"
                                       FontSize="12" Margin="6,0,0,0"
                                       Foreground="{Binding Status, Converter={StaticResource StateToBrush}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource Timestamp}}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <c:Icon Data="{StaticResource IconChevronRight}" Size="14" Margin="10,0,0,0"
                                Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <c:Icon Data="{StaticResource IconScan}" Size="18" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="RegionX" FontSize="13" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click"
                        AutomationProperties.Name="最小化" ToolTip="最小化">
                    <c:Icon Data="{StaticResource IconMinimize}" Size="12" />
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="Maximize_Click"
                        AutomationProperties.Name="最大化" ToolTip="最大化">
                    <c:Icon Data="{StaticResource IconMaximize}" Size="12" />
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="Close_Click"
                        AutomationProperties.Name="关闭窗口" ToolTip="关闭">
                    <c:Icon Data="{StaticResource IconWindowClose}" Size="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 内容：会话列表 -->
        <Grid Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <ScrollViewer Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Margin="24,20,24,16">

                    <!-- 标题 + 搜索 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="历史会话" Style="{StaticResource PageTitleText}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}">
                                <Run Text="共 " /><Run Text="{Binding Sessions.Count, Mode=OneWay}" /><Run Text=" 个会话，" />
                                <Run Text="{Binding TotalTaskCount, Mode=OneWay}" /><Run Text=" 个任务" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Border Height="36" CornerRadius="8" Background="{DynamicResource TitleBarBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="12,0"
                                    Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVisibility}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:Icon Data="{StaticResource IconSearch}" Size="16" />
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="170" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             VerticalContentAlignment="Center" Margin="8,0,0,0"
                                             FontSize="13" />
                                </StackPanel>
                            </Border>

                            <!-- 设置入口（模型、提示词、代理） -->
                            <Button Style="{StaticResource BaseButton}" Height="36" Padding="12,0" Margin="10,0,0,0"
                                    Command="{Binding OpenSettingsCommand}"
                                    AutomationProperties.Name="设置" ToolTip="设置">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource IconSettings}" Size="16" />
                                    <TextBlock Text="设置" FontSize="13" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 会话列表 -->
                    <ItemsControl ItemsSource="{Binding SessionsView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionItemViewModel}">
                                <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Margin="0,0,0,12" ClipToBounds="True">
                                    <StackPanel>
                                        <!-- 会话头 -->
                                        <Button Style="{StaticResource SessionHeaderButton}"
                                                AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding ToggleCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <c:Icon Grid.Column="0" Data="{StaticResource IconChevronRight}" Size="18"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <c:Icon.RenderTransform>
                                                        <RotateTransform Angle="{Binding ChevronAngle, Mode=OneWay}" />
                                                    </c:Icon.RenderTransform>
                                                </c:Icon>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Margin="12,0,0,0" VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="2" Text="{Binding TaskCount, StringFormat={}{0} 个任务}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="12,0,0,0" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <!-- 「进行中」在操作图标左侧 -->
                                                    <TextBlock Text="进行中" FontSize="13"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasActiveTask}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <c:Icon Data="{StaticResource IconRename}" Size="16" Margin="0,0,10,0"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            ToolTip="重命名" Cursor="Hand"
                                                            MouseLeftButtonUp="RenameSession_Click" />
                                                    <c:Icon Data="{StaticResource IconTrash}" Size="16"
                                                            Foreground="{DynamicResource DangerBrush}" ToolTip="删除会话"
                                                            Cursor="Hand" MouseLeftButtonUp="DeleteSession_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- 展开的任务 -->
                                        <ItemsControl ItemsSource="{Binding Tasks}"
                                                      ItemTemplate="{StaticResource TaskRowTemplate}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />

                                        <Border Padding="20,16">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                                <Condition Binding="{Binding IsLoadingTasks}" Value="False" />
                                                                <Condition Binding="{Binding Tasks.Count}" Value="0" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="这个会话还没有任务。" Style="{StaticResource SecondaryText}" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态 -->
                    <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                        <c:Icon Data="{StaticResource IconScan}" Size="48" Foreground="{DynamicResource BorderStrongBrush}"
                                HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部「开始识别」 -->
        <Border Grid.Row="2" Padding="0,14,0,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource WindowBackgroundFadeColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource WindowBackgroundSolidColor}" Offset="0.65" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center">
                <Button Command="{Binding StartCommand}" Cursor="Hand" BorderThickness="0"
                        AutomationProperties.Name="开始识别">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Height="56" Padding="40,0" CornerRadius="28"
                                    Background="{DynamicResource AccentBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:Icon Data="{StaticResource IconScan}" Size="24"
                                            Foreground="{DynamicResource OnAccentBrush}" Thickness="2.2" />
                                    <TextBlock Text="开始识别" FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource OnAccentBrush}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="打开识别框，并创建一个新会话" HorizontalAlignment="Center"
                           Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <!-- 内容：任务详情（在主窗口内展示，不再弹独立窗口） -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              Background="{DynamicResource WindowBackgroundBrush}"
              Panel.ZIndex="10"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
            <views:TaskDetailView DataContext="{Binding Detail}" />
        </Grid>

    </Grid>
</Window>
