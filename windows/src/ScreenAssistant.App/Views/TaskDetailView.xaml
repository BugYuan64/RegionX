<UserControl x:Class="ScreenAssistant.App.Views.TaskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ScreenAssistant.App.ViewModels"
             xmlns:c="clr-namespace:ScreenAssistant.App.Controls"
             FontFamily="{StaticResource UiFont}"
             FontSize="14"
             UseLayoutRounding="True"
             Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：本会话的任务列表 -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer Style="{StaticResource ThinScrollViewer}">
                    <StackPanel Margin="12,20">
                        <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                                Click="BackToMain_Click" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource IconChevronLeft}" Size="16" />
                                <TextBlock Text="历史会话" Margin="6,0,0,0" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Grid Margin="12,0,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SessionName}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding SiblingCount, Mode=OneWay}" /><Run Text=" 个任务" />
                            </TextBlock>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Siblings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SiblingTaskItem}">
                                    <Border x:Name="Row" Padding="12,10" CornerRadius="8" Background="Transparent"
                                            Cursor="Hand" MouseLeftButtonUp="SiblingTask_Click">
                                        <StackPanel>
                                            <TextBlock x:Name="SiblingTitle" Text="{Binding Title}" FontSize="14"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding FirstLine}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                            <Setter TargetName="SiblingTitle" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧：详情 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="24,12" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" MaxWidth="380"
                                   TextTrimming="CharacterEllipsis" />
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                                Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{Binding Kind, Converter={StaticResource KindToIcon}}" Size="13"
                                        Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding KindText}" FontSize="12" Margin="6,0,0,0"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0">
                            <Run Text="{Binding ModelName, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding TimeText, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="重新回答" Style="{StaticResource BaseButton}"
                                HorizontalAlignment="Right" Margin="24,0,0,0" Click="Retry_Click" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Style="{StaticResource ThinScrollViewer}">
                    <Grid Margin="24,20,24,8">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Center" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">

                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="截图 · " />
                            <Run Text="{Binding RegionSizeText, Mode=OneWay}" />
                        </TextBlock>
                        <Border Margin="0,10,0,0" CornerRadius="8" ClipToBounds="True" MaxWidth="460"
                                HorizontalAlignment="Left" Background="{DynamicResource PaperBrush}">
                            <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="260"
                                   Visibility="{Binding Image, Converter={StaticResource NullToVisibility}}" />
                        </Border>

                        <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0">
                            <Run Text="我的要求：" />
                            <Run Text="{Binding KindText, Mode=OneWay}" />
                        </TextBlock>

                        <StackPanel Margin="0,24,0,0">
                            <TextBlock Text="AI 回复" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,10" />
                            <!-- 首次回答 -->
                            <TextBlock Text="{Binding MainAnswer}" TextWrapping="Wrap" FontSize="15" LineHeight="27"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                            <!-- 追问轮次 -->
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MessageItemViewModel}">
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="UserBubble" Grid.Column="1" HorizontalAlignment="Right"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    CornerRadius="16,16,4,16" Padding="12,8" Visibility="Collapsed">
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="15"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </Border>
                                            <TextBlock x:Name="AssistantText" Grid.ColumnSpan="2"
                                                       Text="{Binding Content}" TextWrapping="Wrap"
                                                       FontSize="15" LineHeight="27"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter TargetName="UserBubble" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="AssistantText" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="复制" Style="{StaticResource BaseButton}" FontSize="12" Height="30"
                                    Padding="12,0" Click="Copy_Click" />
                            <Button Content="重新回答" Style="{StaticResource BaseButton}" FontSize="12" Height="30"
                                    Padding="12,0" Margin="8,0,0,0" Click="Retry_Click" />
                        </StackPanel>

                        <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="24,10,24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource WindowBackgroundFadeColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource WindowBackgroundSolidColor}" Offset="0.7" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FollowUpBox" Grid.Column="0"
                                         Text="{Binding FollowUpText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         FontSize="15" MinHeight="36" VerticalContentAlignment="Center"
                                         IsEnabled="{Binding IsStreaming, Converter={StaticResource InverseBool}}"
                                         PreviewKeyDown="FollowUpBox_PreviewKeyDown" />
                                <Button Grid.Column="1" Width="36" Height="36" Padding="0" BorderThickness="0"
                                        Cursor="Hand" IsEnabled="{Binding CanSend}"
                                        Command="{Binding SendFollowUpCommand}" ToolTip="发送">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Command" Value="{Binding SendFollowUpCommand}" />
                                            <Setter Property="IsEnabled" Value="{Binding CanSend}" />
                                            <Setter Property="ToolTip" Value="发送追问" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                    <Setter Property="Command" Value="{Binding CancelFollowUpCommand}" />
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Setter Property="ToolTip" Value="停止生成" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" CornerRadius="18"
                                                    Background="{DynamicResource AccentBrush}">
                                                <c:Icon Data="{StaticResource IconSend}" Size="18" Thickness="2.4"
                                                        Foreground="{DynamicResource OnAccentBrush}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <CheckBox Content="追问时附带原截图" Style="{StaticResource CheckBoxStyle}"
                                  IsChecked="{Binding IncludeImageOnFollowUp}" Margin="2,8,0,0"
                                  Click="IncludeImage_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
