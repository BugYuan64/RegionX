<UserControl x:Class="ScreenAssistant.App.Views.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ScreenAssistant.App.ViewModels"
             xmlns:c="clr-namespace:ScreenAssistant.App.Controls"
             FontFamily="{StaticResource UiFont}">

    <!--
        对话列表：用户的追问靠右，AI 回复靠左。
        主回复（第一条助手消息）与后续追问都走同一个模板。
    -->
    <ItemsControl x:Name="List" ItemsSource="{Binding}" Margin="0" Padding="0">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:MessageItemViewModel}">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <!-- 用户：靠右，最多占 5/6 宽度 -->
                    <Border x:Name="UserBubble" Grid.Column="1" HorizontalAlignment="Right"
                            Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14,14,4,14"
                            Padding="12,8" Visibility="Visible">
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>

                    <!-- AI：靠左，占满整行 -->
                    <Border x:Name="AssistantBlock" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                            Visibility="Collapsed">
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13"
                                   LineHeight="22" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                        <Setter TargetName="UserBubble" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="AssistantBlock" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
