<Window x:Class="ScreenAssistant.App.Views.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ScreenAssistant.App.Controls"
        Title="工具栏"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 工具栏按钮：图标在上、文字在下 -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="50" />
            <Setter Property="Width" Value="84" />
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButtonContent" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>


    <Border Background="{DynamicResource ChromeBrush}" CornerRadius="12" Padding="8"
            BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.28" Direction="270" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <!-- 问答：与翻译同样式（白色线条 + 黑灰底） -->
            <Button x:Name="AnswerButton" Style="{StaticResource ToolButton}" Click="Answer_Click"
                    AutomationProperties.Name="问答"
                    ToolTip="截取框内区域并回答问题">
                <StackPanel Style="{StaticResource ToolButtonContent}">
                    <c:Icon Data="{StaticResource IconQuestion}" Size="20" Thickness="2"
                            Foreground="{DynamicResource ChromeTextBrush}" />
                    <TextBlock Text="问答" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource ChromeTextBrush}" />
                </StackPanel>
            </Button>

            <Button x:Name="TranslateButton" Style="{StaticResource ToolButton}" Click="Translate_Click"
                    AutomationProperties.Name="翻译"
                    Margin="4,0,0,0" ToolTip="截取框内区域并翻译文字">
                <StackPanel Style="{StaticResource ToolButtonContent}">
                    <c:Icon Data="{StaticResource IconTranslate}" Size="20" Foreground="{DynamicResource ChromeTextBrush}" />
                    <TextBlock Text="翻译" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource ChromeTextBrush}" />
                </StackPanel>
            </Button>

            <Button x:Name="ExtractButton" Style="{StaticResource ToolButton}" Click="Extract_Click"
                    AutomationProperties.Name="提取图文"
                    Width="96" Margin="4,0,0,0" ToolTip="截取框内区域并提取文字">
                <StackPanel Style="{StaticResource ToolButtonContent}">
                    <c:Icon Data="{StaticResource IconText}" Size="20" Foreground="{DynamicResource ChromeTextBrush}" />
                    <TextBlock Text="提取图文" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource ChromeTextBrush}" />
                </StackPanel>
            </Button>

            <Rectangle Width="1" Height="28" Fill="{DynamicResource ChromeBorderBrush}" Margin="8,0" VerticalAlignment="Center" />

            <!-- 模型：点击弹出下拉框 -->
            <Button x:Name="ModelButton" Style="{StaticResource ToolButton}" Width="120"
                    Click="Model_Click" AutomationProperties.Name="模型" ToolTip="选择模型">
                <Button.Background>
                    <SolidColorBrush Color="Transparent" />
                </Button.Background>

                <StackPanel Style="{StaticResource ToolButtonContent}">
                    <!-- 品牌图标：深色主题用浅色，白色主题用深色，跟随 Chrome 文字色 -->
                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                        <Path x:Name="ModelBrandIcon"
                              Data="{Binding ModelName, Converter={StaticResource BrandIcon}}"
                              Stroke="{DynamicResource ChromeTextBrush}"
                              StrokeThickness="0"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Fill="{DynamicResource ChromeTextBrush}" />
                    </Viewbox>
                    <TextBlock x:Name="ModelButtonText" Text="模型" FontSize="12" FontWeight="SemiBold"
                               Margin="0,2,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource ChromeTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="110" />
                </StackPanel>
            </Button>

            <Button x:Name="TopmostButton" Style="{StaticResource ToolButton}" Width="64" Margin="4,0,0,0"
                    Click="Topmost_Click" AutomationProperties.Name="置顶" ToolTip="切换识别框置顶">
                <StackPanel Style="{StaticResource ToolButtonContent}">
                    <c:Icon x:Name="TopmostIcon" Data="{StaticResource IconPin}" Size="20"
                            Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="TopmostText" Text="置顶" FontSize="12" FontWeight="SemiBold"
                               Margin="0,2,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ToolButton}" Width="64" Margin="4,0,0,0" Click="Exit_Click"
                    AutomationProperties.Name="退出"
                    ToolTip="退出识别框（任务会保留）">
                <Button.Background>
                    <SolidColorBrush Color="Transparent" />
                </Button.Background>
                <StackPanel Style="{StaticResource ToolButtonContent}">
                    <c:Icon Data="{StaticResource IconClose}" Size="20" Thickness="2.2"
                            Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Text="退出" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
