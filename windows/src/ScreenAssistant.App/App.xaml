<Application x:Class="ScreenAssistant.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ScreenAssistant.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 0 号字典是主题令牌，运行时可整体替换（见 ThemeApplier） -->
                <ResourceDictionary Source="Styles/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Styles/Theme.xaml" />
                <ResourceDictionary Source="Styles/Icons.xaml" />
                <ResourceDictionary Source="Styles/BrandIcons.xaml" />
                <ResourceDictionary Source="Styles/IconControl.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:EnumToTextConverter x:Key="EnumToText" />
            <converters:TaskStateToBrushConverter x:Key="StateToBrush" />
            <converters:TaskStateToSoftBrushConverter x:Key="StateToSoftBrush" />
            <converters:TaskStateToTextConverter x:Key="StateToText" />
            <converters:TaskKindToIconConverter x:Key="KindToIcon" />
            <converters:BrandIconConverter x:Key="BrandIcon" />
            <converters:TimestampConverter x:Key="Timestamp" />
            <converters:RelativeTimeConverter x:Key="RelativeTime" />
            <converters:PathToImageConverter x:Key="PathToImage" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
            <converters:StringNotEmptyToVisibilityConverter x:Key="TextToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
